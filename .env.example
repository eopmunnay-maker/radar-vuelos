# Copia este archivo como .env y completa tus credenciales.
# Sin TRAVELPAYOUTS_TOKEN el agente corre en MODO DEMO (precios simulados).

# Token de la Data API de Travelpayouts (https://app.travelpayouts.com → API token)
TRAVELPAYOUTS_TOKEN=

# Moneda de los precios (usd, pen, eur...)
MONEDA=usd

# Bot de Telegram: crea uno con @BotFather y pega el token.
# TELEGRAM_CHAT_ID: escribe a tu bot y visita
# https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
